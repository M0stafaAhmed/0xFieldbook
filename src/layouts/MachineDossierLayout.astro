---
// Shared shell for a machine's 3 dossier pages (Overview / User / Root).
// Phase 4 component inventory: "MachineDossierLayout" — identical
// structure and tab strip across all 5 machines, difficulty badge via the
// design system's --difficulty-* tokens (phase-4-design-system.md §1).
import BaseLayout from "./BaseLayout.astro";
import { MACHINES } from "../data/navGroups";

interface Props {
  machineId: string; // e.g. "VE-01"
  difficulty: string; // e.g. "Very Easy"
  title: string;
  currentRoute: string;
  activePhase: "overview" | "user" | "root";
}
const { machineId, difficulty, title, currentRoute, activePhase } = Astro.props;

const machine = MACHINES.find((m) => m.id === machineId);
const slug = machine?.slug ?? machineId.toLowerCase();
const difficultyTone = difficulty.toLowerCase().replace(/\s+/g, "-");

const tabs = [
  { key: "overview", label: "Overview", href: `/machines/${slug}` },
  { key: "user", label: "User", href: `/machines/${slug}/user` },
  { key: "root", label: "Root", href: `/machines/${slug}/root` },
] as const;
---

<BaseLayout title={title} currentRoute={currentRoute}>
  <div class="content-container">
    <header style="margin-bottom: var(--space-5);">
      <div style="display:flex; align-items:center; gap: var(--space-3); margin-bottom: var(--space-2);">
        <span class="badge badge--filled" data-tone={difficultyTone}>{difficulty}</span>
        <span class="card-meta" style="margin:0;">{machineId}</span>
      </div>
      <h1>{title}</h1>
    </header>

    <div role="tablist" aria-label={`${machineId} dossier sections`} class="machine-tabs">
      {
        tabs.map((tab) => (
          <a
            href={tab.href}
            role="tab"
            aria-selected={activePhase === tab.key ? "true" : "false"}
            aria-current={activePhase === tab.key ? "page" : undefined}
            class="machine-tab"
          >
            {tab.label}
          </a>
        ))
      }
    </div>

    <div role="tabpanel">
      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  .machine-tabs {
    display: flex;
    gap: var(--space-2);
    border-bottom: var(--border-width) solid var(--border-subtle);
    margin-bottom: var(--space-5);
    overflow-x: auto;
  }

  .machine-tab {
    padding: var(--space-3) var(--space-4);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: 600;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
  }

  .machine-tab:hover {
    color: var(--text-primary);
    text-decoration: none;
  }

  .machine-tab[aria-selected="true"] {
    color: var(--accent-amber);
    border-bottom-color: var(--accent-amber);
  }
</style>
