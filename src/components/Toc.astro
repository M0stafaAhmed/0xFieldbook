---
interface Props { headings: { depth: number; slug: string; text: string }[] }
const items = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length >= 6 && (
    <details class="toc">
      <summary>On this page ({items.length} sections)</summary>
      <ol>
        {items.map((h) => <li class={h.depth === 3 ? "toc-l3" : undefined}><a href={`#${h.slug}`}>{h.text}</a></li>)}
      </ol>
    </details>
  )
}
