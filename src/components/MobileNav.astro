---
// Mobile navigation drawer, built with the "checkbox hack": a visually
// hidden checkbox plus two <label for="..."> controls (open/close) and a
// CSS sibling selector. This needs zero JavaScript to open or close
// (Phase 5 §4), while still giving an explicit, keyboard-operable close
// button, which a bare <details> element cannot. Only visible below the
// md breakpoint (see global.css).
import { NAV_GROUPS, MACHINES } from "../data/navGroups";
import { getGroupRoutes } from "../data/routes";

interface Props {
  currentRoute: string;
}
const { currentRoute } = Astro.props;

function isActive(route: string) {
  return route === currentRoute;
}
---

<div class="mobile-nav-root">
  <input type="checkbox" id="mobile-nav-toggle" class="mobile-nav-checkbox" />
  <label for="mobile-nav-toggle" class="mobile-menu-toggle">
    <span aria-hidden="true">&#9776;</span> Menu
  </label>
  <nav class="mobile-nav" aria-label="Primary navigation (mobile)">
    <label for="mobile-nav-toggle" class="mobile-nav-close">
      <span aria-hidden="true">&times;</span> Close
    </label>
    <ul>
      {
        NAV_GROUPS.map((group) => (
          <li>
            <a
              href={group.indexRoute}
              class="sidebar-link"
              aria-current={isActive(group.indexRoute) ? "page" : undefined}
            >
              {group.label}
            </a>
            {group.expandable && (
              <ul class="sidebar-sublist">
                {group.key === "Machines"
                  ? MACHINES.map((m) => (
                      <li>
                        <a
                          href={`/machines/${m.slug}`}
                          class="sidebar-link"
                          aria-current={isActive(`/machines/${m.slug}`) ? "page" : undefined}
                        >
                          {m.id}
                        </a>
                      </li>
                    ))
                  : getGroupRoutes(group.key)
                      .filter((r) => r.route !== group.indexRoute)
                      .map((r) => (
                        <li>
                          <a
                            href={r.route}
                            class="sidebar-link"
                            aria-current={isActive(r.route) ? "page" : undefined}
                          >
                            {r.title}
                          </a>
                        </li>
                      ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<script>
  // Escape closes the open mobile drawer and returns focus to its control (keyboard parity with Close).
  document.addEventListener("keydown", (e) => {
    const box = document.getElementById("mobile-nav-toggle") as HTMLInputElement | null;
    if (e.key === "Escape" && box?.checked) { box.checked = false; box.focus(); }
  });
</script>
