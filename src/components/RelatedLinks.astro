---
interface Props { heading: string; links: { href: string; label: string }[] }
const { heading, links } = Astro.props;
---

{
  links.length > 0 && (
    <section class="related-links" aria-label={heading}>
      <h2>{heading}</h2>
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </section>
  )
}
